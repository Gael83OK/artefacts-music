# Artefacts Music V1 — Configuration des Variables d'Environnement de Production

# URL de l'Application (HTTPS obligatoire en production)
NEXT_PUBLIC_APP_URL=https://app.artefacts-music.fr

# Fuseau Horaire Officiel (Europe/Paris)
TZ=Europe/Paris

# Clés d'API & Sécurité
# (NE JAMAIS COMMITER DE VRAIES CLÉS DE PRODUCTION DANS CE FICHIER)
AUTH_SECRET=changer_ce_secret_en_production_longueur_32_caracteres_min
DATABASE_URL=postgresql://user:password@localhost:5432/artefacts_music?sslmode=require

# Configuration du Stockage des Fichiers (S3 / CDN)
STORAGE_BUCKET_NAME=artefacts-documents-prod
STORAGE_REGION=eu-west-3

# Configuration Supabase Client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

